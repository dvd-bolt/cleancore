{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "CleanCore default window capabilities without elevation or arbitrary shell execution",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-ping",
    "allow-get-metric-snapshot",
    "allow-get-process-list",
    "allow-get-app-settings",
    "allow-save-refresh-interval",
    "allow-toggle-pause-metrics",
    "allow-get-cleanup-availability",
    "allow-get-execution-preview",
    "allow-prepare-cleanup-confirmation",
    "allow-start-confirmed-cleanup",
    "allow-get-cleanup-operation",
    "allow-cancel-cleanup",
    "allow-get-cleanup-journal",
    "allow-start-cleanup-scan",
    "allow-get-scan-progress",
    "allow-cancel-cleanup-scan",
    "allow-get-cleanup-preview",
    "allow-get-quick-directories",
    "allow-start-disk-analysis",
    "allow-get-disk-analysis-progress",
    "allow-get-disk-analysis-report",
    "allow-start-duplicate-scan",
    "allow-get-duplicate-scan-progress",
    "allow-get-duplicate-report",
    "allow-cancel-disk-task",
    "allow-get-resource-history"
  ]
}
