{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanCore",
  "version": "0.0.4",
  "identifier": "com.cleancore.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "python scripts/prepare_bundle.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CleanCore",
        "width": 1080,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Р›РѕРєР°Р»СЊРЅС‹Р№ РјРѕРЅРёС‚РѕСЂ Рё Р±РµР·РѕРїР°СЃРЅС‹Р№ Р°РЅР°Р»РёР· Windows",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "zlib"
      }
    }
  }
}
