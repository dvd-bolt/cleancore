{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanCore",
  "version": "0.0.1",
  "identifier": "com.cleancore.app",
  "build": {
    "beforeDevCommand": "npx pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CleanCore",
        "width": 1080,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
